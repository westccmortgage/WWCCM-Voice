# Final active-state template. Do not apply until Core is deployed, its
# secrets are present, its three switches are approved, and /ready preflight
# is scheduled. Replace every angle-bracket placeholder in Render's dashboard.

VOICE_RUNTIME_ENABLED=true
VOICE_TRANSPORT=relay
VOICE_ADMISSION_MODE=test
VOICE_TEST_ALLOWED_CALLER=<EXACT_OWNER_E164>

VOICE_RELAY_URL=https://hbqlhplgqwuesrovbiye.supabase.co/functions/v1/core-v2-voice-relay
VOICE_RELAY_KEY_ID=render-relay
VOICE_RELAY_HMAC_SECRET=<SAME_NEW_SECRET_AS_CORE>
VOICE_RELAY_TURN_TIMEOUT_MS=9000

TWILIO_AUTH_TOKEN=<EXISTING_TWILIO_AUTH_TOKEN>
TWILIO_ACCOUNT_SID=<EXISTING_TWILIO_ACCOUNT_SID>

AGENT_LANGUAGE=en
MAX_CALL_SECONDS=105
MAX_CONVERSATION_TURNS=6
MAX_TTS_CHARACTERS=4000

# Intentionally unused in relay mode; do not create or rotate these merely
# for the pilot: VOICE_ADMISSION_URL, VOICE_TURN_URL, VOICE_SHARED_SECRET,
# DEEPGRAM_API_KEY, ELEVENLABS_API_KEY, ELEVENLABS_VOICE_ID.
