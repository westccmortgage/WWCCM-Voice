# Template only. Never commit a populated copy and never paste secret values
# into chat. The three switches stay false until the separately approved live
# test. Replace every angle-bracket placeholder in a private local copy.

CORE_V2_RELAY_ENABLED=false
CORE_V2_RELAY_ALLOW_PROVIDER_NETWORK=false
CORE_V2_RELAY_ALLOW_PAID_CALLS=false

CORE_V2_RELAY_DB_URL=<EXISTING_RESTRICTED_VOICE_RUNTIME_DATABASE_URL>
CORE_V2_RELAY_KEY_ID=render-relay
CORE_V2_RELAY_HMAC_SECRET=<NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS>
CORE_V2_RELAY_CALLER_APP=wallet-voice
CORE_V2_RELAY_TENANT_ID=wccm

CORE_V2_RELAY_PROVIDER_ID=anthropic
CORE_V2_RELAY_PROVIDER_REGISTRY='{"providers":[{"providerId":"anthropic","baseUrl":"https://api.anthropic.com","apiKeyEnvironmentVariable":"ANTHROPIC_API_KEY","models":["claude-haiku-4-5-20251001"],"defaultModel":"claude-haiku-4-5-20251001","maximumOutputTokens":300,"maximumInputTokens":8000,"requestTimeoutMs":7000,"maximumMaterialBytes":8000,"maximumMaterialBytesPerItem":8000,"supportedMediaTypes":["text/plain"],"capabilities":{"claude-haiku-4-5-20251001":{"forcedToolChoice":false,"strictSchema":false,"images":false,"thinking":"none"}}}],"pricing":[{"providerId":"anthropic","model":"claude-haiku-4-5-20251001","effectiveFrom":"2025-10-15","currency":"USD","inputPerMillionTokens":1,"outputPerMillionTokens":5,"cachedInputPerMillionTokens":0.1,"cacheWritePerMillionTokens":1.25}]}'
ANTHROPIC_API_KEY=<EXISTING_ANTHROPIC_KEY>

# One request per turn, six turns. Reservation ceiling:
# 8,000 * $1.25/M + 300 * $5/M = $0.0115/turn; six = $0.069/call.
CORE_V2_RELAY_BUDGET_POLICY='{"currency":"USD","authorizedMaximumUsd":0.069,"maximumPerTurnUsd":0.0115,"maximumProviderCallsPerTurn":1,"maximumProviderCallsPerCall":6,"maximumTurnsPerCall":6,"maximumInputTokensPerTurn":8000,"maximumOutputTokensPerTurn":300,"maximumInputTokensPerCall":48000,"maximumOutputTokensPerCall":1800,"maximumReasoningTokensPerCall":0,"wallClockDeadlineMs":105000}'

# This exact expiry is for 2026-10-06 in America/Los_Angeles only. If launch
# occurs later, replace suiteId and expiresAt, then recalculate the owner hash:
# printf %s '+1XXXXXXXXXX' | shasum -a 256
CORE_V2_RELAY_ADMISSION_POLICY='{"protocol":"core-v2.voice-admission-policy.1","suiteId":"emma-owner-20261006","ownerIdentityDigest":"<SHA256_HEX_OF_EXACT_OWNER_E164>","expiresAt":"2026-10-07T06:59:59.000Z","maximumCalls":3,"maximumVoiceWebhooks":6,"maximumCallSeconds":105,"maximumTurns":6,"maximumBrainRequests":6,"maximumTtsCharacters":4000}'

