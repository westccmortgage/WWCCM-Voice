# WWCCM-Voice — environment variables. Copy to .env for local dev (never commit .env).

# Port (Render sets this automatically in production)
PORT=8080

# Master activation gate. Leave false until credentials, spend policy, and all
# acceptance gates are complete; /voice and /media reject traffic while false.
VOICE_RUNTIME_ENABLED=false

# Independent release-admission gate. `disabled` rejects every call even when
# the runtime gate is enabled. For an approved isolated owner test use `test`
# plus an exact owner and the durable admission endpoint. Whole-suite ceilings
# are server-owned in Core; `production` remains a later reviewed change.
VOICE_ADMISSION_MODE=disabled
VOICE_TEST_ALLOWED_CALLER=
VOICE_ADMISSION_URL=https://walletwccm.com/api/voice-admission

# The advisor "brain" endpoint on the Wallet WCCM site (image repo).
VOICE_TURN_URL=https://walletwccm.com/api/voice-advisor-turn
# Shared secret — set the SAME value as VOICE_SHARED_SECRET on the Netlify site.
VOICE_SHARED_SECRET=change-me-to-a-long-random-string

# Spoken language for the whole call: en | ru | es | zh
AGENT_LANGUAGE=en

# Speech backend. Keep `legacy` until Cloudflare Workers AI access and billing
# entitlement are explicitly verified. No model call is needed to edit/test code.
SPEECH_PROVIDER=legacy

# Optional single-provider speech path (Nova-3 STT + Aura-1 TTS via AI Gateway).
# The existing text-gateway success does NOT prove this token can use Workers AI.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_ID=
CLOUDFLARE_AI_GATEWAY_TOKEN=
CLOUDFLARE_STT_MODEL=@cf/deepgram/nova-3
CLOUDFLARE_TTS_MODEL=@cf/deepgram/aura-1
CLOUDFLARE_TTS_SPEAKER=asteria

# Legacy Deepgram (speech-to-text)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en

# Legacy ElevenLabs (text-to-speech). Pick a voice ID from your ElevenLabs account.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Required — verifies Twilio on POST /voice and the /media WebSocket upgrade.
TWILIO_AUTH_TOKEN=

# Hard per-call provider-usage limits. Keep production disabled until the owner
# approves exact values together with the all-in paid-test ceiling.
MAX_CALL_SECONDS=1800
MAX_CONVERSATION_TURNS=60
MAX_TTS_CHARACTERS=25000

# Emma on Twilio ConversationRelay. `media-stream` (default) keeps the existing
# bridge. `relay` makes /voice return ConversationRelay TwiML; Twilio handles
# speech, and each final caller utterance is one signed request to Core.
VOICE_TRANSPORT=media-stream
VOICE_RELAY_URL=
VOICE_RELAY_KEY_ID=
VOICE_RELAY_HMAC_SECRET=
TWILIO_ACCOUNT_SID=
VOICE_RELAY_TURN_TIMEOUT_MS=9000
# Optional ConversationRelay voice selection. Empty uses Twilio's account
# defaults; set only after confirming the provider/voice in the account.
VOICE_RELAY_TTS_PROVIDER=
VOICE_RELAY_VOICE=
