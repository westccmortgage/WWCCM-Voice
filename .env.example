# WWCCM-Voice — environment variables. Copy to .env for local dev (never commit .env).

# Port (Render sets this automatically in production)
PORT=8080

# The advisor "brain" endpoint on the Wallet WCCM site (image repo).
VOICE_TURN_URL=https://walletwccm.com/api/voice-advisor-turn
# Shared secret — set the SAME value as VOICE_SHARED_SECRET on the Netlify site.
VOICE_SHARED_SECRET=change-me-to-a-long-random-string

# Spoken language for the whole call: en | ru | es | zh
AGENT_LANGUAGE=en

# Deepgram (speech-to-text)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en

# ElevenLabs (text-to-speech). Pick a voice ID from your ElevenLabs account.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Required — verifies Twilio on POST /voice and the /media WebSocket upgrade.
TWILIO_AUTH_TOKEN=
